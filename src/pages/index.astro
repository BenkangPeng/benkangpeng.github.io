import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi! I'm Benkang Peng.</h1>
			<p>
				My interests lie in compilers, particularly AI compilers and compiler infrastructure like
				LLVM and MLIR. My past research involved digital circuit design.
			</p>
			<p>
				I use this blog to share technical notes and things I've learned along the way.
			</p>
			<p>
				Feel free to reach out at <a href="mailto:benkangpeng@163.com">benkangpeng@163.com</a> if
				you'd like to connect or exchange ideas~
			</p>
		</main>
		<Footer />
	</body>
</html>
